# ============== SERVER ==============
APP_HOST=0.0.0.0
APP_PORT=8081
GRPC_PORT=9090

# ============== DATABASE (Required - No Default) ==============
DATABASE_URL=postgres://yomu:yomu_password@localhost:5432/yomu_engine

# ============== REDIS (Required - No Default) ==============
REDIS_URL=redis://localhost:6379

# ============== JAVA CORE SERVICE (Required - No Default) ==============
JAVA_CORE_URL=http://localhost:8080
JAVA_CORE_API_KEY=dev-shared-internal-api-key
INTERNAL_API_KEY=dev-shared-internal-api-key

# ============== SECURITY (Required - No Default) ==============
# Must be at least 32 characters for Java backend compatibility
JWT_SECRET=change-me-to-a-secure-random-string-min-32-chars-long

# ============== DATABASE POOL ==============
PG_POOL_MAX_CONNECTIONS=20
PG_POOL_MIN_CONNECTIONS=5
PG_POOL_ACQUIRE_TIMEOUT_SECS=5
PG_POOL_MAX_LIFETIME_SECS=1800
PG_POOL_IDLE_TIMEOUT_SECS=300

# ============== LOGGING ==============
RUST_LOG=info
LOG_DIR=/var/log/yomu

# ============== OPEN TELEMETRY (Optional) ==============
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-central1.grafana.net/otlp
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=yomu-backend-rust
OTEL_ENVIRONMENT=development
OTEL_TRACES_SAMPLER_ARG=0.1
GRAFANA_API_KEY=your_grafana_api_key_here

# ============== SENTRY (Optional) ==============
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ============== CARGO NEXTEST ==============
PROPTEST_CASES=256
